@@ -65,6 +65,17 @@
     double start_time; // the earliest time of servicing
     double end_time;   // the latest time of returning to depot
     double max_distance_reachable; // given the current battery capacity, the maximum distance that EV can reach
+
+    // HMA-LD: consumo dependiente de la carga. e_ij(L) = h*d_ij*(1 + beta*(L/C - rho)).
+    // La bateria se sigue manejando como "distancia restante" (energia/h), por lo que
+    // el consumo de un arco en esas unidades es edist(i,j,L) = d_ij*(1 + beta*(L/C - rho)).
+    // Con beta = 0 el factor es exactamente 1.0 y edist == dist (bit a bit).
+    double load_beta = 0.2;
+    double load_rho = 0.0;
+    inline double edist(int i, int j, double load) const
+    {
+        return this->dist[i][j] * (1.0 + this->load_beta * (load / this->vehicle.capacity - this->load_rho));
+    }
     
 
     int DC; // ID of depot, 0 by default
